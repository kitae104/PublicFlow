      "position": [
        380,
        540
      ],
      "id": "c9a4f730-2d58-4e1b-8a63-0f7e5b1d2c72",
      "name": "Google Gemini Chat Model1"
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "본인이메일@example.com"
        },
        "start": "={{ $json.output.제출기한 + 'T09:00:00' }}",
        "end": "={{ $json.output.제출기한 + 'T10:00:00' }}",
        "additionalFields": {
          "summary": "=[공문 기한] {{ $json.output.문서제목 }}",
          "description": "=담당부서: {{ $json.output.담당부서 }}\n필요조치: {{ $json.output.필요조치 }}"
        }
      },
      "type": "n8n-nodes-base.googleCalendar",
